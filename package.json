{
  "name": "sourcemaps",
  "private": true,
  "description": "Monorepo for @jridgewell's collection of sourcemap packages",
  "scripts": {
    "benchmark": "turbo run benchmark",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "lint": "turbo run lint",
    "test": "turbo run test --parallel"
  },
  "workspaces": [
    "packages/*"
  ],
  "author": "Justin Ridgewell <justin@ridgewell.name>",
  "license": "MIT",
  "packageManager": "npm@11.19.1",
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.39.5",
    "@types/mocha": "10.0.10",
    "@types/node": "24.0.7",
    "@types/sinon": "22.0.2",
    "benchmark": "2.1.4",
    "esbuild": "0.25.5",
    "eslint": "9.39.5",
    "mocha": "12.0.3",
    "npm-run-all": "4.1.5",
    "prettier": "3.6.2",
    "rimraf": "6.1.4",
    "sinon": "21.1.2",
    "tsx": "4.20.3",
    "turbo": "2.11.10",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.0"
  },
  "overrides": {
    "glob@>=9 <14.0.2": "14.0.3",
    "minimatch@>=7 <11.0.1": "11.0.4"
  }
}
